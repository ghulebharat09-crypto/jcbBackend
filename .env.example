PORT=8200
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database Config (PostgreSQL)
# Option A: Individual credentials
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=jcb_fleet_management
DATABASE_SSL=false

# Option B: Render Internal or External PostgreSQL Connection URL
# DATABASE_URL=postgres://username:password@dpg-xxxx.render.com/database_name

# JWT Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Admin Secret
ADMIN_REGISTRATION_KEY=your_admin_secret_key
