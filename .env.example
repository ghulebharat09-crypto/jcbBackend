PORT=8200
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database Config
# Option A: Individual credentials
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=jcb_fleet_management
DATABASE_SSL=false

# Option B: Cloud MySQL Connection URL (e.g., TiDB Cloud, Aiven, Railway)
# DATABASE_URL=mysql://user:password@host:port/database

# JWT Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Admin Secret
ADMIN_REGISTRATION_KEY=your_admin_secret_key
